# Flutter/Dart related
# See https://github.com/flutter/flutter/wiki/Customizing-the-default-.gitignore

# Build outputs
build/
.dart_tool/
.pub-cache/
.packages
pubspec.lock

# Generated plugin registrant
**/generated_plugin_registrant.dart

# Flutter tooling
.flutter-plugins
.flutter-plugins-dependencies
.flutter-versions

# Misc
*.log
*.tmp
*.temp
*.swp
.DS_Store

# IDEs and editors
/.idea/
*.iml
*.ipr
*.iws
.vscode/
/.vscode/*

# Android
/.gradle/
/android/.gradle/
android/.cxx/
**/local.properties
android/app/debug.keystore
*.jks
*.keystore

# iOS
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/ios/Flutter/Generated.xcconfig
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/ephemeral/
Pods/
DerivedData/
*.xcworkspace
*.xcuserdata
*.xcuserstate

# macOS
/macos/Flutter/ephemeral/
/macos/Flutter/GeneratedPluginRegistrant.*

# Linux and Windows build folders
/linux/flutter/ephemeral/
/linux/CMakeLists.txt.user
/windows/flutter/ephemeral/

# Flutter web
/web/outputs/

# Coverage and reports
/coverage/
/.dart_tool/package_config.json

# Keys, credentials and secrets (add any local secrets here)
/.env
key.properties

# Other
/.idea/
/.metadata
/.flutter-plugins
/.flutter-plugins-dependencies
